#!/usr/bin/env python3
import glob
import time
from pathlib import Path

def cpu_sample():
    values = [int(value) for value in Path("/proc/stat").read_text().splitlines()[0].split()[1:]]
    idle = values[3] + values[4]
    return sum(values), idle

def first_sensor(name, label, field):
    for sensor_name in glob.glob("/sys/class/hwmon/hwmon*/name"):
        base = Path(sensor_name).parent
        try:
            if Path(sensor_name).read_text().strip() != name:
                continue
        except OSError:
            continue
        for label_path in base.glob(f"{field}*_label"):
            try:
                if label_path.read_text().strip() == label:
                    return label_path.with_name(label_path.name.replace("_label", "_input"))
            except OSError:
                continue
    return None

def fallback_temp_sensor():
    for name in ["k10temp", "zenpower", "coretemp", "cpu_thermal", "acpitz"]:
        for sensor_name in glob.glob("/sys/class/hwmon/hwmon*/name"):
            base = Path(sensor_name).parent
            try:
                if Path(sensor_name).read_text().strip() == name:
                    inputs = sorted(base.glob("temp*_input"))
                    if inputs:
                        return inputs[0]
            except OSError:
                continue
    return None

def fallback_power_sensor():
    for name in ["amdgpu", "BAT0", "BAT1", "power_meter"]:
        for sensor_name in glob.glob("/sys/class/hwmon/hwmon*/name"):
            base = Path(sensor_name).parent
            try:
                if Path(sensor_name).read_text().strip() == name:
                    inputs = sorted(base.glob("power*_input"))
                    if inputs:
                        return inputs[0]
            except OSError:
                continue
    return None

def gib(value_kib):
    return f"{value_kib / 1024 / 1024:.1f} GiB"

total1, idle1 = cpu_sample()
time.sleep(0.25)
total2, idle2 = cpu_sample()
delta_total = total2 - total1
cpu_percent = 0 if delta_total <= 0 else (delta_total - (idle2 - idle1)) * 100 / delta_total

temp_path = first_sensor("k10temp", "Tctl", "temp") or fallback_temp_sensor()
power_path = first_sensor("amdgpu", "PPT", "power") or fallback_power_sensor()

try:
    cpu_temp = f"{int(temp_path.read_text()) / 1000:.0f} °C" if temp_path else "—"
except OSError:
    cpu_temp = "—"

try:
    if power_path:
        val = int(power_path.read_text())
        if val > 1_000_000:
            cpu_watt = f"{val / 1_000_000:.1f} W"
        else:
            cpu_watt = f"{val / 1000:.1f} W"
    else:
        cpu_watt = "—"
except OSError:
    cpu_watt = "—"

meminfo = {}
for line in Path("/proc/meminfo").read_text().splitlines():
    parts = line.split(":", 1)
    if len(parts) == 2:
        meminfo[parts[0].strip()] = int(parts[1].split()[0])

ram_total = meminfo.get("MemTotal", 1)
ram_available = meminfo.get("MemAvailable", 0)
ram_used = max(0, ram_total - ram_available)

print(f"cpu_percent={cpu_percent:.0f}%")
print(f"cpu_temp={cpu_temp}")
print(f"cpu_watt={cpu_watt}")
print(f"ram_total={gib(ram_total)}")
print(f"ram_used={gib(ram_used)}")
print(f"ram_free={gib(ram_available)}")
print(f"ram_percent={ram_used * 100 / ram_total:.1f}")
