#!/usr/bin/env python3
import glob
import json
import os
import subprocess
import sys
import time
from pathlib import Path

def load_config():
    paths = [
        Path.home() / ".config" / "omarchy" / "power-monitor.json",
        Path(__file__).parent / "config.json"
    ]
    cfg = {}
    for p in paths:
        if p.exists():
            try:
                cfg = json.loads(p.read_text())
                break
            except Exception:
                pass

    return {
        "temp_name": os.getenv("POWER_TEMP_NAME", cfg.get("tempSensorName", "k10temp")),
        "temp_label": os.getenv("POWER_TEMP_LABEL", cfg.get("tempSensorLabel", "Tctl")),
        "power_name": os.getenv("POWER_NAME", cfg.get("powerSensorName", "amdgpu")),
        "power_label": os.getenv("POWER_LABEL", cfg.get("powerSensorLabel", "PPT")),
        "sample_delay": float(os.getenv("POWER_SAMPLE_DELAY", cfg.get("sampleDelaySeconds", 0.25)))
    }

def get_charge_limit():
    for p in glob.glob("/sys/class/power_supply/BAT*/charge_control_end_threshold"):
        try:
            val = int(Path(p).read_text().strip())
            writable = os.access(p, os.W_OK)
            return True, val, writable
        except Exception:
            return True, 100, False
    return False, 100, False

def set_charge_limit(val):
    val = max(50, min(100, int(val)))
    for p in glob.glob("/sys/class/power_supply/BAT*/charge_control_end_threshold"):
        try:
            with open(p, "w") as f:
                f.write(f"{val}\n")
            return True, val
        except Exception:
            pass

    enable = (val < 100)
    device = "/org/freedesktop/UPower/devices/battery_BAT0"
    for d in glob.glob("/sys/class/power_supply/BAT*"):
        name = Path(d).name
        device = f"/org/freedesktop/UPower/devices/battery_{name}"
        break

    p = subprocess.run([
        "/usr/bin/busctl", "call",
        "org.freedesktop.UPower",
        device,
        "org.freedesktop.UPower.Device",
        "EnableChargeThreshold",
        "b",
        "true" if enable else "false"
    ], capture_output=True, text=True)

    _, current, _ = get_charge_limit()
    return p.returncode == 0, current

if len(sys.argv) > 1 and sys.argv[1] == "--set-limit":
    target_val = int(sys.argv[2]) if len(sys.argv) > 2 else 100
    _, cur = set_charge_limit(target_val)
    print(f"charge_limit={cur}")
    sys.exit(0)

def cpu_sample():
    values = [int(value) for value in Path("/proc/stat").read_text().splitlines()[0].split()[1:]]
    idle = values[3] + values[4]
    return sum(values), idle

def first_sensor(name, label, field):
    for sensor_name in glob.glob("/sys/class/hwmon/hwmon*/name"):
        base = Path(sensor_name).parent
        try:
            if Path(sensor_name).read_text().strip() != name:
                continue
        except OSError:
            continue
        for label_path in base.glob(f"{field}*_label"):
            try:
                if label_path.read_text().strip() == label:
                    return label_path.with_name(label_path.name.replace("_label", "_input"))
            except OSError:
                continue
    return None

def fallback_temp_sensor():
    for name in ["k10temp", "zenpower", "coretemp", "cpu_thermal", "acpitz"]:
        for sensor_name in glob.glob("/sys/class/hwmon/hwmon*/name"):
            base = Path(sensor_name).parent
            try:
                if Path(sensor_name).read_text().strip() == name:
                    inputs = sorted(base.glob("temp*_input"))
                    if inputs:
                        return inputs[0]
            except OSError:
                continue
    return None

def fallback_power_sensor():
    for name in ["amdgpu", "BAT0", "BAT1", "power_meter"]:
        for sensor_name in glob.glob("/sys/class/hwmon/hwmon*/name"):
            base = Path(sensor_name).parent
            try:
                if Path(sensor_name).read_text().strip() == name:
                    inputs = sorted(base.glob("power*_input"))
                    if inputs:
                        return inputs[0]
            except OSError:
                continue
    return None

def gib(value_kib):
    return f"{value_kib / 1024 / 1024:.1f} GiB"

cfg = load_config()

total1, idle1 = cpu_sample()
time.sleep(cfg["sample_delay"])
total2, idle2 = cpu_sample()
delta_total = total2 - total1
cpu_percent = 0 if delta_total <= 0 else (delta_total - (idle2 - idle1)) * 100 / delta_total

temp_path = first_sensor(cfg["temp_name"], cfg["temp_label"], "temp") or fallback_temp_sensor()
power_path = first_sensor(cfg["power_name"], cfg["power_label"], "power") or fallback_power_sensor()

try:
    cpu_temp = f"{int(temp_path.read_text()) / 1000:.0f} °C" if temp_path else "—"
except OSError:
    cpu_temp = "—"

try:
    if power_path:
        val = int(power_path.read_text())
        if val > 1_000_000:
            cpu_watt = f"{val / 1_000_000:.1f} W"
        else:
            cpu_watt = f"{val / 1000:.1f} W"
    else:
        cpu_watt = "—"
except OSError:
    cpu_watt = "—"

meminfo = {}
for line in Path("/proc/meminfo").read_text().splitlines():
    parts = line.split(":", 1)
    if len(parts) == 2:
        meminfo[parts[0].strip()] = int(parts[1].split()[0])

ram_total = meminfo.get("MemTotal", 1)
ram_available = meminfo.get("MemAvailable", 0)
ram_used = max(0, ram_total - ram_available)

charge_supported, charge_limit, charge_writable = get_charge_limit()

print(f"cpu_percent={cpu_percent:.0f}%")
print(f"cpu_temp={cpu_temp}")
print(f"cpu_watt={cpu_watt}")
print(f"ram_total={gib(ram_total)}")
print(f"ram_used={gib(ram_used)}")
print(f"ram_free={gib(ram_available)}")
print(f"ram_percent={ram_used * 100 / ram_total:.1f}")
print(f"charge_limit={charge_limit}")
print(f"charge_limit_supported={'true' if charge_supported else 'false'}")
print(f"charge_limit_writable={'true' if charge_writable else 'false'}")
